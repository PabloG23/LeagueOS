# ==============================================================================
# LeagueOS — Variables de Entorno de Configuración (Plantilla de Ejemplo)
# Copia este archivo como '.env' y completa con tus credenciales reales.
# NUNCA subas el archivo '.env' real a Git.
# ==============================================================================

# --- Base de Datos PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/leagueos
SPRING_DATASOURCE_USERNAME=leagueos_user
SPRING_DATASOURCE_PASSWORD=tu_password_de_postgres

# --- Almacenamiento en la Nube (Cloudflare R2) ---
# Se utiliza para guardar fotos de jugadores, logos de equipos y cédulas arbitrales
CF_R2_ACCOUNT_ID=tu_cloudflare_account_id
CF_R2_ACCESS_KEY=tu_cloudflare_access_key
CF_R2_SECRET_KEY=tu_cloudflare_secret_key
CF_R2_BUCKET=leagueos-media

# --- Inteligencia Artificial (Google Gemini) ---
# Utilizada para la extracción OCR automática de datos de INE / identificaciones
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- Seguridad y Tokens JWT ---
# Clave secreta para firmar los tokens de sesión (mínimo 64 caracteres seguros en producción)
APP_JWT_SECRET=tu_clave_secreta_jwt_muy_larga_y_segura_para_produccion

# --- Dominios Permitidos (CORS) ---
# Dominios separados por coma autorizados para comunicarse con la API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://nuestrodeporte.com
